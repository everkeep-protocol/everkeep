  "constants": [
    {
      "name": "MAX_INACTIVITY_PERIOD",
      "docs": [
        "Upper bound on `inactivity_period` (100 years). Keeps",
        "`last_check_in + inactivity_period` far from `i64::MAX`, so a vault can",
        "never become permanently unclaimable through overflow."
      ],
      "type": "i64",
      "value": "3153600000"
    },
