# Cluster the app targets: devnet (default) | localnet | mainnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Optional RPC override. Defaults: devnet https://api.devnet.solana.com,
# localnet http://127.0.0.1:8899. The public Devnet RPC is rate-limited;
# a dedicated Devnet endpoint (Helius, Triton, QuickNode...) is more reliable.
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# The program ID is not configurable here; it comes from lib/everkeep/idl/everkeep_contract.json.
